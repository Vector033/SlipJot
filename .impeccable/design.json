  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Default action in the app: white on body red.",
      "html": "<button class=\"ds-btn-primary\">บันทึก</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 20px;border:0;border-radius:12px;background:var(--color-red,#b3121c);color:#fff;font:600 1rem/1.6 Anuphan,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,transform 150ms}.ds-btn-primary:hover{background:var(--color-red-deep,#8e0e16)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid #f5c400;outline-offset:2px}"
    },
    {
      "name": "Plate Button",
      "kind": "button",
      "refersTo": "button-plate",
      "description": "The one headline action per surface: ink on plate yellow with an ink border.",
      "html": "<button class=\"ds-btn-plate\">ลองดูบัญชีเดโม <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-plate{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border:2px solid #1b1715;border-radius:12px;background:#f5c400;color:#1b1715;font:700 1rem/1.6 Anuphan,system-ui,sans-serif;box-shadow:0 6px 14px -8px rgb(27 23 21/.45);cursor:pointer;transition:background-color 150ms,transform 150ms}.ds-btn-plate:hover{background:#d9ab00}.ds-btn-plate:active{transform:translateY(1px)}.ds-btn-plate:focus-visible{outline:3px solid #f5c400;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White with a 2px line border; border goes ink on hover.",
      "html": "<button class=\"ds-btn\">ส่งออก CSV</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border:2px solid #dde1e6;border-radius:12px;background:#fff;color:#1b1715;font:600 .875rem/1.6 Anuphan,system-ui,sans-serif;cursor:pointer;transition:border-color 150ms}.ds-btn:hover{border-color:#1b1715}.ds-btn:focus-visible{outline:3px solid #f5c400;outline-offset:2px}"
    },
    {
      "name": "Ghost Button on Red",
      "kind": "button",
      "refersTo": "button-ghost-red",
      "description": "Secondary action on a red region: rose outline, white text.",
      "html": "<div style=\"background:#b3121c;padding:20px\"><button class=\"ds-btn-ghost-red\">สมัครแล้วส่งสลิปจริง</button></div>",
      "css": ".ds-btn-ghost-red{display:inline-flex;align-items:center;min-height:48px;padding:12px 20px;border:2px solid rgb(255 217 219/.6);border-radius:12px;background:transparent;color:#fff;font:600 1rem/1.6 Anuphan,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-btn-ghost-red:hover{border-color:#fff;background:#8e0e16}.ds-btn-ghost-red:focus-visible{outline:3px solid #f5c400;outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "2px line stroke, red caret, ink border on focus; the unsure variant is plate wash.",
      "html": "<label class=\"ds-label\">ผู้รับ / ร้าน</label><input class=\"ds-input\" value=\"ก๋วยเตี๋ยวเรือลุงชัย\"><input class=\"ds-input ds-input-unsure\" value=\"ร้านข้าวมันไก่ป่าแดง\">",
      "css": ".ds-label{display:block;margin-bottom:6px;font:500 .875rem/1.6 Anuphan,system-ui,sans-serif;color:#4a4440}.ds-input{display:block;width:100%;margin-bottom:8px;padding:10px 14px;border:2px solid #dde1e6;border-radius:12px;background:#fff;color:#1b1715;caret-color:#b3121c;font:400 1rem/1.6 Anuphan,system-ui,sans-serif;outline:none;transition:border-color 150ms}.ds-input:focus{border-color:#1b1715}.ds-input:focus-visible{outline:3px solid #f5c400;outline-offset:2px}.ds-input-unsure{background:#fff4c2;border-color:#d9ab00}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Category filter pill; the lit stop is plate yellow with an ink border.",
      "html": "<span class=\"ds-chip\">ทั้งหมด</span> <span class=\"ds-chip ds-chip-on\">อาหาร</span> <span class=\"ds-chip\">เดินทาง</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;border:2px solid #dde1e6;border-radius:9999px;background:#fff;color:#4a4440;font:500 .875rem/1.6 Anuphan,system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:border-color 150ms}.ds-chip:hover{border-color:#6e6762}.ds-chip-on{border-color:#1b1715;background:#f5c400;color:#1b1715;font-weight:600}.ds-chip-on:hover{border-color:#1b1715}"
    },
    {
      "name": "Route Board",
      "kind": "card",
      "refersTo": "board",
      "description": "White panel with an ink title strip; rows divided by chrome trim.",
      "html": "<section class=\"ds-board\"><header class=\"ds-board-head\"><h3>ตามหมวด</h3><span>ตุลาคม 2569</span></header><ul class=\"ds-rows\"><li><span>อาหาร</span><b>฿3,240.00</b></li><li><span>เดินทาง</span><b>฿1,180.50</b></li><li><span>ค่าหอ</span><b>฿4,500.00</b></li></ul></section>",
      "css": ".ds-board{border-radius:16px;background:#fff;box-shadow:0 1px 0 #dde1e6,0 8px 24px -16px rgb(27 23 21/.25);overflow:hidden;font:400 1rem/1.6 Anuphan,system-ui,sans-serif;color:#1b1715}.ds-board-head{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:10px 20px;background:#1b1715;color:#fff}.ds-board-head h3{margin:0;font-size:1rem;font-weight:700;line-height:1.3}.ds-board-head span{font-size:.875rem;color:#ffd9db}.ds-rows{list-style:none;margin:0;padding:8px 20px 12px}.ds-rows li{display:flex;justify-content:space-between;padding:10px 0}.ds-rows li+li{background-image:linear-gradient(#c8cdd3 0 1px,#8f969e 1px 2px);background-repeat:no-repeat;background-size:100% 2px}.ds-rows b{font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Plate",
      "kind": "custom",
      "refersTo": "plate",
