NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54622/postgres

# Optional. Without a key SlipJot reads slips with local Thai OCR and categorises with rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# USD per 1M tokens, for the cost-per-slip numbers. Update when Google's price list changes.
GEMINI_PRICE_IN=0.30
GEMINI_PRICE_OUT=2.50
# Where tesseract caches its Thai language data (defaults to the OS temp dir).
TESSDATA_CACHE=
